<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>check-business-checked-count</name>
  <uuid>552f53c1-8302-4b29-a23b-e63c0002abd5</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the passenger of 'the request' is business class
    and the checked baggage count of 'the request' is more than 2
then
    add violation "Business class passengers are allowed 2 checked bags" to 'the request' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>