<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>check-carry-on-weight</name>
  <uuid>cadbeb17-df7b-4d06-9a39-42d9dbccadaa</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the passenger of 'the request' is economy class
    and the total carry-on weight of 'the request' is more than 7
then
    add violation "Economy class carry-on weight exceeds 7 kg limit" to 'the request' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>