<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>medium-risk-ldl</name>
  <uuid>f8a9b0c1-d2e3-4f5a-6b7c-8d9e0f1a2b3c</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the risk level of 'the patient' is ""
    and the LDL cholesterol of 'the patient' is at least 130
    and the LDL cholesterol of 'the patient' is at most 159
then
    set the risk level of 'the patient' to "Medium" ;
    add "Medium risk: LDL cholesterol between 130 and 159 mg/dL" to the messages of 'the patient' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>