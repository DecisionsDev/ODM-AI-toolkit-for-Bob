<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>high-risk-ldl</name>
  <uuid>f2a3b4c5-d6e7-8f9a-0b1c-2d3e4f5a6b7c</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the LDL cholesterol of 'the patient' is at least 160
then
    set the risk level of 'the patient' to "High" ;
    add "High risk: LDL cholesterol >= 160 mg/dL" to the messages of 'the patient' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>