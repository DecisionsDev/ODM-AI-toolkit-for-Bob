<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>high-risk-current-smoker</name>
  <uuid>a3b4c5d6-e7f8-9a0b-1c2d-3e4f5a6b7c8d</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the smoking history of 'the patient' is "current"
then
    set the risk level of 'the patient' to "High" ;
    add "High risk: Current smoker" to the messages of 'the patient' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>