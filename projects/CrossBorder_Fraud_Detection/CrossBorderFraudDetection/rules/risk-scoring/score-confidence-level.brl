<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">

  <name>score-confidence-level</name>

  <uuid>effa0f4e-ad38-495f-9aad-551a9345e9f1</uuid>

  <locale>en_US</locale>

  <documentation><![CDATA[
    Rule: Score Confidence Level
    Package: risk-scoring
    Description: Sets the confidence level based on the composite risk score.
    Score 0-30: LOW confidence (accept with monitoring)
    Score 31-60: MEDIUM confidence (flag for review)
    Score >60: HIGH confidence (block / EDD)
    Tags: risk-scoring, confidence, composite-score
  ]]></documentation>

  <definition><![CDATA[if
    the total score of the risk score of 'the transaction' is more than 60

  then
    set the confidence level of the risk score of 'the transaction' to "HIGH" ;
    add audit message "Confidence level set to HIGH - composite score exceeds 60" to 'the transaction' ;]]></definition>

</ilog.rules.studio.model.brl:ActionRule>
