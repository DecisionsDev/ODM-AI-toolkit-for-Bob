<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">

  <name>score-offshore-provider</name>

  <uuid>68f3d14a-e48a-4fef-b798-ffd1ce219d78</uuid>

  <locale>en_US</locale>

  <documentation><![CDATA[
    Rule: Score Offshore Provider
    Package: risk-scoring
    Description: Assigns 20 points when an offshore provider EDD signal is triggered
    (retail customer, no business profile, offshore-registered merchant).
    Score: 20 points
    Tags: risk-scoring, offshore, EDD, AML
  ]]></documentation>

  <definition><![CDATA[if
    the risk score of 'the transaction' has offshore provider detected

  then
    record score 20 on the risk score of 'the transaction' ;
    record triggered rule "OFFSHORE_PROVIDER" on the risk score of 'the transaction' ;
    add audit message "Risk score +20: Offshore provider EDD signal - retail customer with offshore merchant" to 'the transaction' ;]]></definition>

</ilog.rules.studio.model.brl:ActionRule>
