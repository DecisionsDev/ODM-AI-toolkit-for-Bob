<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">

  <name>detect-exotic-currency</name>

  <uuid>6b4b2d87-141d-4bfe-9de2-fd4b77eafe1f</uuid>

  <locale>en_US</locale>

  <documentation><![CDATA[
    Rule: Detect Exotic Currency (Rule 1.3)
    Package: compliance-prescreening
    Description: Detects transactions in rarely-used or exotic currencies not linked to
    known travel or business behavior. Exotic currencies include KZT (Kazakhstan Tenge),
    XOF (West African CFA Franc), UZS (Uzbekistani Som), GHS (Ghana Cedi),
    MNT (Mongolian Tugrik), KGS (Kyrgyz Som).
    Risk Signal: EXOTIC_CURRENCY
    Tags: compliance, currency, exotic, risk, prescreening
  ]]></documentation>

  <definition><![CDATA[if
    'the transaction' is exotic currency
    or the currency of 'the transaction' is one of { "KZT" , "XOF" , "UZS" , "GHS" , "MNT" , "KGS" , "LYD" , "SDG" , "SYP" , "AFN" }
    and it is not true that 'the transaction' is travel declared

  then
    make it true that the risk score of 'the transaction' has exotic currency detected ;
    add risk factor "Transaction uses a rarely-used or exotic currency not linked to known travel" to the risk score of 'the transaction' ;
    add audit message "EXOTIC_CURRENCY detected - unusual currency without travel justification" to 'the transaction' ;]]></definition>

</ilog.rules.studio.model.brl:ActionRule>
