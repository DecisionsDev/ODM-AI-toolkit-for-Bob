<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>high-risk-age-bp</name>
  <uuid>e1f2a3b4-c5d6-7e8f-9a0b-1c2d3e4f5a6b</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the age of 'the patient' is at least 60
    and the systolic blood pressure of 'the patient' is at least 140
then
    set the risk level of 'the patient' to "High" ;
    add "High risk: Age 60+ with systolic BP >= 140 mmHg" to the messages of 'the patient' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>