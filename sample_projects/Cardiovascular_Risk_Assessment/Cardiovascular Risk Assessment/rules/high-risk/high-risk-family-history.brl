<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>high-risk-family-history</name>
  <uuid>c5d6e7f8-a9b0-1c2d-3e4f-5a6b7c8d9e0f</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    'the patient' has family history of CVD
then
    set the risk level of 'the patient' to "High" ;
    add "High risk: Family history of cardiovascular disease" to the messages of 'the patient' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>