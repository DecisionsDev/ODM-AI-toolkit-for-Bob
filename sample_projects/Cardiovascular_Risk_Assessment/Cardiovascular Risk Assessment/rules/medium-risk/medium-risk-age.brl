<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>medium-risk-age</name>
  <uuid>d6e7f8a9-b0c1-2d3e-4f5a-6b7c8d9e0f1a</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the risk level of 'the patient' is ""
    and the age of 'the patient' is at least 45
    and the age of 'the patient' is at most 59
then
    set the risk level of 'the patient' to "Medium" ;
    add "Medium risk: Age between 45 and 59" to the messages of 'the patient' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>