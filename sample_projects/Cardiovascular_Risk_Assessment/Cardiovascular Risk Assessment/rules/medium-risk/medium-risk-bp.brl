<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>medium-risk-bp</name>
  <uuid>e7f8a9b0-c1d2-3e4f-5a6b-7c8d9e0f1a2b</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the risk level of 'the patient' is ""
    and the systolic blood pressure of 'the patient' is at least 130
    and the systolic blood pressure of 'the patient' is at most 139
then
    set the risk level of 'the patient' to "Medium" ;
    add "Medium risk: Systolic BP between 130 and 139 mmHg" to the messages of 'the patient' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>