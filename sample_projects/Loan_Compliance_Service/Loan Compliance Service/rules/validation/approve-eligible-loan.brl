<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>approve-eligible-loan</name>
  <uuid>f7a8b9c0-d1e2-3f4a-5b6c-7d8e9f0a1b2c</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    'the request' is eligible
    and the interest rate of 'the request' is more than 0
then
    set the reason of 'the request' to "Loan approved with " + the interest rate of 'the request' + "% APR." ;
    add "Loan application approved" to the messages of 'the request' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>