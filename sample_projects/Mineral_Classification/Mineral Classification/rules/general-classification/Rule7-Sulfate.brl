<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>Rule7-Sulfate</name>
  <uuid>4b5c6d7e-8f9a-0b1c-2d3e-4f5a6b7c8d9e</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    'the specimen' contains sulfur
    and 'the specimen' contains oxygen
    and the environment of 'the specimen' is one of { "evaporite", "sedimentary" }
then
    set the mineral class of 'the specimen' to "Sulfate" ;
    add "Rule 7: Classified as Sulfate - contains sulfur and oxygen (SO4 group) and forms in evaporitic or sedimentary environments" to the messages of 'the specimen' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>