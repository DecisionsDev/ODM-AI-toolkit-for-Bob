<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>Rule11-Nesosilicate</name>
  <uuid>8f9a0b1c-2d3e-4f5a-6b7c-8d9e0f1a2b3c</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the mineral class of 'the specimen' is "Silicate"
    and 'the specimen' has isolated tetrahedra
then
    set the silicate subclass of 'the specimen' to "Nesosilicate" ;
    add "Rule 11: Classified as Nesosilicate - contains isolated SiO4 groups without shared oxygen atoms between tetrahedra" to the messages of 'the specimen' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>