<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">

  <name>validate-required-fields</name>

  <uuid>5cca02f4-59b8-4b2e-9d4f-82bfe77d92d3</uuid>

  <locale>en_US</locale>

  <documentation><![CDATA[
    Rule: Validate Required Fields
    Package: data-enrichment
    Description: Ensures the minimum required fields for cross-border analysis are present.
    If transaction ID or merchant country code is missing, set to REVIEW with reason CBF-001.
    Tags: validation, data-enrichment, required-fields
  ]]></documentation>

  <definition><![CDATA[if
    the merchant country code of 'the transaction' is null

  then
    set the fraud decision of 'the transaction' to "REVIEW" ;
    set the decision reason code of 'the transaction' to "CBF-001-MISSING-MERCHANT-COUNTRY" ;
    set the recommended action of 'the transaction' to "MANUAL_REVIEW" ;
    add audit message "Merchant country code is missing - cannot perform cross-border analysis" to 'the transaction' ;]]></definition>

</ilog.rules.studio.model.brl:ActionRule>
