<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0"
    xmlns:xmi="http://www.omg.org/XMI"
    xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">

  <name>detect-mandatory-reporting</name>

  <uuid>1c3ecab3-ad29-429c-847f-879b8725e500</uuid>

  <locale>en_US</locale>

  <documentation><![CDATA[
    Rule: Detect Mandatory Reporting Threshold (Rule 5.1)
    Package: compliance-prescreening
    Description: Any cross-border transaction over EUR 10,000 must be logged and subjected
    to reporting thresholds under EU AMLD5 or FinCEN CTR rules. Marks the transaction
    for mandatory compliance logging.
    Risk Signal: MANDATORY_REPORTING
    Tags: compliance, AMLD5, FinCEN, CTR, mandatory-reporting, prescreening
  ]]></documentation>

  <definition><![CDATA[if
    'the transaction' is cross border
    and the amount of 'the transaction' is more than 10000

  then
    make it true that the risk score of 'the transaction' has mandatory reporting required ;
    make it true that 'the transaction' is mandatory reporting ;
    add risk factor "Cross-border transaction exceeds EUR 10,000 - mandatory reporting required (AMLD5/FinCEN CTR)" to the risk score of 'the transaction' ;
    add audit message "MANDATORY_REPORTING triggered - cross-border amount exceeds EUR 10,000" to 'the transaction' ;]]></definition>

</ilog.rules.studio.model.brl:ActionRule>
