<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>set-final-status</name>
  <uuid>43780868-80aa-428d-8df8-ebf3c4f3ef3a</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    'the request' is compliant
then
    set the status of 'the request' to "APPROVED" ;
    add message "Luggage compliance check passed" to 'the request' ;
else
    set the status of 'the request' to "REJECTED" ;
    add message "Luggage compliance check failed - see violations" to 'the request' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>