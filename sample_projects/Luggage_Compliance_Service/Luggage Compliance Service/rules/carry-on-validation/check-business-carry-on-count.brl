<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>check-business-carry-on-count</name>
  <uuid>1ec4579a-baeb-4e84-a130-e66c6c14acb1</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the passenger of 'the request' is business class
    and the carry-on count of 'the request' is more than 2
then
    add violation "Business class passengers are allowed 2 carry-on bags plus 1 personal item" to 'the request' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>