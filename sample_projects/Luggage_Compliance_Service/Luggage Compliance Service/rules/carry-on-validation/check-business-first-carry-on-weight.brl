<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>check-business-first-carry-on-weight</name>
  <uuid>e174158d-e27e-4b59-8c9a-9a7071d1b8dc</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the passenger of 'the request' is premium class
    and the total carry-on weight of 'the request' is more than 12
then
    add violation "Business/First class carry-on weight exceeds 12 kg limit" to 'the request' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>