<?xml version="1.0" encoding="UTF-8"?>
<ilog.rules.studio.model.brl:ActionRule xmi:version="2.0" xmlns:xmi="http://www.omg.org/XMI" xmlns:ilog.rules.studio.model.brl="http://ilog.rules.studio/model/brl.ecore">
  <name>check-economy-checked-count</name>
  <uuid>a3d441fe-7d4c-40b8-9f05-f6dc4f8acc27</uuid>
  <locale>en_US</locale>
  <definition><![CDATA[if
    the passenger of 'the request' is economy class
    and the checked baggage count of 'the request' is more than 1
then
    add violation "Economy class passengers are allowed 1 checked bag" to 'the request' ;]]></definition>
</ilog.rules.studio.model.brl:ActionRule>