{
  "name": "odm-ruleproject",
  "displayName": "IBM ODM Rule Project & Decision Service",
  "description": "IBM Operational Decision Manager (ODM) \u2014 visual editors, syntax highlighting, ruleflow viewer, and vocabulary navigation for ODM Decision Services and Rule Projects (.brl, .bom, .rfl, .dop, .dep).",
  "version": "0.1.0",
  "publisher": "ibm-odm",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "https://github.com/DecisionsDev/ODM-AI-toolkit-for-Bob.git",
    "directory": "vscode-odm-ruleproject"
  },
  "engines": {
    "vscode": "^1.85.0"
  },
  "categories": [
    "Programming Languages",
    "Snippets"
  ],
  "keywords": [
    "ODM",
    "BRL",
    "BAL",
    "IBM",
    "rules",
    "business rules"
  ],
  "activationEvents": [],
  "main": "./out/extension.js",
  "contributes": {
    "languages": [
      {
        "id": "brl",
        "aliases": [
          "BRL",
          "ODM Rule",
          "BAL"
        ],
        "extensions": [
          ".brl"
        ],
        "configuration": "./language-configuration.json",
        "icon": {
          "light": "./icons/brl-light.svg",
          "dark": "./icons/brl-dark.svg"
        }
      },
      {
        "id": "odm-voc",
        "aliases": [
          "ODM Vocabulary"
        ],
        "extensions": [
          ".voc"
        ],
        "configuration": "./voc-language-configuration.json"
      },
      {
        "id": "odm-var",
        "aliases": [
          "ODM Variable Set"
        ],
        "extensions": [
          ".var"
        ],
        "configuration": "./odm-xml-language-configuration.json"
      },
      {
        "id": "odm-rulepackage",
        "aliases": [
          "ODM Rule Package"
        ],
        "extensions": [
          ".rulepackage"
        ],
        "filenames": [
          ".rulepackage"
        ],
        "configuration": "./odm-xml-language-configuration.json"
      },
      {
        "id": "odm-ruleproject",
        "aliases": [
          "ODM Rule Project"
        ],
        "filenames": [
          ".ruleproject"
        ],
        "configuration": "./odm-xml-language-configuration.json"
      },
      {
        "id": "odm-b2xa",
        "aliases": [
          "ODM BOM to ARL Translation"
        ],
        "extensions": [
          ".b2xa"
        ],
        "configuration": "./odm-xml-language-configuration.json"
      },
      {
        "id": "odm-dta",
        "aliases": [
          "ODM Decision Table"
        ],
        "extensions": [
          ".dta"
        ],
        "configuration": "./odm-xml-language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "brl",
        "scopeName": "source.brl",
        "path": "./syntaxes/brl.tmLanguage.json"
      },
      {
        "language": "odm-voc",
        "scopeName": "source.odm-voc",
        "path": "./syntaxes/voc.tmLanguage.json"
      },
      {
        "language": "odm-var",
        "scopeName": "text.xml.odm-var",
        "path": "./syntaxes/var.tmLanguage.json"
      },
      {
        "language": "odm-rulepackage",
        "scopeName": "text.xml.odm-rulepackage",
        "path": "./syntaxes/rulepackage.tmLanguage.json"
      },
      {
        "language": "odm-ruleproject",
        "scopeName": "text.xml.odm-ruleproject",
        "path": "./syntaxes/ruleproject.tmLanguage.json"
      },
      {
        "language": "odm-b2xa",
        "scopeName": "text.xml.odm-b2xa",
        "path": "./syntaxes/b2xa.tmLanguage.json"
      },
      {
        "language": "odm-dta",
        "scopeName": "text.xml.odm-dta",
        "path": "./syntaxes/dtable.tmLanguage.json"
      }
    ],
    "snippets": [
      {
        "language": "brl",
        "path": "./snippets/brl.json"
      }
    ],
    "customEditors": [
      {
        "viewType": "odm-ruleproject.ruleView",
        "displayName": "ODM Rule View",
        "selector": [
          {
            "filenamePattern": "*.brl"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "odm-ruleproject.bomView",
        "displayName": "ODM Business Vocabulary",
        "selector": [
          {
            "filenamePattern": "*.bom"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "odm-ruleproject.ruleflowView",
        "displayName": "ODM Ruleflow",
        "selector": [
          {
            "filenamePattern": "*.rfl"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "odm-ruleproject.operationView",
        "displayName": "ODM Decision Operation",
        "selector": [
          {
            "filenamePattern": "*.dop"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "odm-ruleproject.deploymentView",
        "displayName": "ODM Deployment Configuration",
        "selector": [
          {
            "filenamePattern": "*.dep"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "odm-ruleproject.vocView",
        "displayName": "ODM Vocabulary Editor",
        "selector": [
          {
            "filenamePattern": "*.voc"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "odm-ruleproject.varView",
        "displayName": "ODM Variable Set Editor",
        "selector": [
          {
            "filenamePattern": "*.var"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "odm-ruleproject.rulepackageView",
        "displayName": "ODM Rule Package",
        "selector": [
          {
            "filenamePattern": ".rulepackage"
          }
        ],
        "priority": "default"
      },
      {
        "viewType": "odm-ruleproject.dtableView",
        "displayName": "ODM Decision Table",
        "selector": [
          {
            "filenamePattern": "*.dta"
          }
        ],
        "priority": "default"
      }
    ],
    "commands": [
      {
        "command": "odm-ruleproject.openRuleView",
        "title": "Open Business View",
        "category": "ODM",
        "icon": "$(preview)"
      },
      {
        "command": "odm-ruleproject.openAsXml",
        "title": "Open as Text",
        "category": "ODM",
        "icon": "$(code)"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "odm-ruleproject.openRuleView",
          "when": "resourceExtname =~ /^\\.(brl|bom|rfl|dop|dep|voc|var|dta)$/ && activeEditor == workbench.editors.files.textFileEditor",
          "group": "navigation"
        },
        {
          "command": "odm-ruleproject.openAsXml",
          "when": "activeCustomEditorId =~ /^odm-ruleproject\\./",
          "group": "navigation"
        }
      ]
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "lint": "eslint src --ext ts"
  },
  "devDependencies": {
    "@types/vscode": "^1.85.0",
    "@types/node": "20.x",
    "@typescript-eslint/eslint-plugin": "^7.0.0",
    "@typescript-eslint/parser": "^7.0.0",
    "eslint": "^8.57.0",
    "typescript": "^5.4.5"
  }
}
