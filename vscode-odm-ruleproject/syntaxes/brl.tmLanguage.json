{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "BRL",
  "scopeName": "source.brl",
  "fileTypes": [
    "brl"
  ],
  "patterns": [
    {
      "include": "#xml-rule"
    },
    {
      "include": "#header"
    },
    {
      "include": "#rule-block"
    },
    {
      "include": "#comment"
    }
  ],
  "repository": {
    "comment": {
      "patterns": [
        {
          "name": "comment.line.double-slash.brl",
          "match": "//.*$"
        },
        {
          "name": "comment.block.brl",
          "begin": "/\\*",
          "end": "\\*/",
          "beginCaptures": {
            "0": {
              "name": "punctuation.definition.comment.begin.brl"
            }
          },
          "endCaptures": {
            "0": {
              "name": "punctuation.definition.comment.end.brl"
            }
          }
        }
      ]
    },
    "header": {
      "comment": "BOM file header directives",
      "patterns": [
        {
          "name": "meta.header.brl",
          "match": "^\\s*(property)\\s+(\\S+)\\s+(\"[^\"]*\")",
          "captures": {
            "1": {
              "name": "keyword.other.property.brl"
            },
            "2": {
              "name": "entity.other.attribute-name.brl"
            },
            "3": {
              "name": "string.quoted.double.brl"
            }
          }
        }
      ]
    },
    "rule-block": {
      "comment": "A complete BAL rule: metadata headers + if/then/else",
      "name": "meta.rule.brl",
      "begin": "^\\s*(\\brule\\s+\"[^\"]+\"\\s*(?:version\\s+\\d+)?(?:\\s*;)?|\\brule\\s+\"[^\"]+\")",
      "end": "(?=^\\s*(?:rule\\s+\"|/\\*|//))",
      "beginCaptures": {
        "0": {
          "name": "meta.rule.header.brl"
        },
        "1": {
          "name": "entity.name.function.rule.brl"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#rule-metadata"
        },
        {
          "include": "#if-section"
        },
        {
          "include": "#then-section"
        },
        {
          "include": "#definitions-section"
        }
      ]
    },
    "rule-metadata": {
      "comment": "metadata directives inside a rule block",
      "patterns": [
        {
          "name": "meta.directive.brl",
          "match": "^\\s*(\\bpriority\\b|\\bagenda-group\\b|\\bactivation-group\\b|\\bauto-focus\\b|\\bdialect\\b|\\bdate-effective\\b|\\bdate-expires\\b|\\bduration\\b|\\block-on-active\\b|\\bno-loop\\b|\\bruleflow-group\\b|\\bsalience\\b|\\benabled\\b)\\s+(.*?)$",
          "captures": {
            "1": {
              "name": "keyword.other.directive.brl"
            },
            "2": {
              "name": "constant.other.directive-value.brl"
            }
          }
        },
        {
          "name": "meta.package.brl",
          "match": "^\\s*(package)\\s+(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.other.package.brl"
            },
            "2": {
              "name": "entity.name.namespace.brl"
            }
          }
        },
        {
          "name": "meta.import.brl",
          "match": "^\\s*(import)\\s+(\\S+)",
          "captures": {
            "1": {
              "name": "keyword.control.import.brl"
            },
            "2": {
              "name": "entity.name.class.brl"
            }
          }
        }
      ]
    },
    "definitions-section": {
      "name": "meta.definitions.brl",
      "begin": "^\\s*\\b(definitions)\\b",
      "end": "(?=\\b(?:if|then)\\b)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.definitions.brl"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#set-statement"
        },
        {
          "include": "#variable-ref"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        }
      ]
    },
    "if-section": {
      "name": "meta.if.brl",
      "begin": "^\\s*\\b(if)\\b",
      "end": "(?=^\\s*\\b(?:then|else)\\b)",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.if.brl"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#condition"
        }
      ]
    },
    "then-section": {
      "name": "meta.then.brl",
      "begin": "^\\s*\\b(then)\\b",
      "end": "(?=^\\s*(?:rule\\s+\"|/\\*|//))|^\\s*$(?=\\n\\s*(?:rule\\s+\"|//))",
      "beginCaptures": {
        "1": {
          "name": "keyword.control.then.brl"
        }
      },
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#action"
        }
      ]
    },
    "condition": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#logical-operators"
        },
        {
          "include": "#comparison-operators"
        },
        {
          "include": "#null-keywords"
        },
        {
          "include": "#collection-keywords"
        },
        {
          "include": "#negation"
        },
        {
          "include": "#variable-ref"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#boolean-literal"
        },
        {
          "include": "#set-literal"
        }
      ]
    },
    "action": {
      "patterns": [
        {
          "include": "#comment"
        },
        {
          "include": "#action-keywords"
        },
        {
          "include": "#set-statement"
        },
        {
          "include": "#variable-ref"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#boolean-literal"
        },
        {
          "include": "#statement-terminator"
        }
      ]
    },
    "logical-operators": {
      "patterns": [
        {
          "name": "keyword.operator.logical.brl",
          "match": "\\b(and|or)\\b"
        }
      ]
    },
    "comparison-operators": {
      "patterns": [
        {
          "name": "keyword.operator.comparison.brl",
          "match": "\\b(is more than|is less than|is at least|is at most|is not null|is null|is not|is one of|is)\\b"
        }
      ]
    },
    "null-keywords": {
      "patterns": [
        {
          "name": "constant.language.null.brl",
          "match": "\\bnull\\b"
        }
      ]
    },
    "negation": {
      "patterns": [
        {
          "name": "keyword.operator.negation.brl",
          "match": "\\bit is not true that\\b"
        }
      ]
    },
    "collection-keywords": {
      "patterns": [
        {
          "name": "keyword.other.collection.brl",
          "match": "\\b(has any|number of items in|add .+ to the|remove .+ from the)\\b"
        }
      ]
    },
    "action-keywords": {
      "patterns": [
        {
          "name": "keyword.other.action.brl",
          "match": "\\b(set the|make it|add|remove|print|tally|record|log|apply ruleflow|halt)\\b"
        }
      ]
    },
    "set-statement": {
      "name": "meta.set-statement.brl",
      "match": "\\b(set)\\s+('[^']+'|\"[^\"]+\")\\s+(to)\\b",
      "captures": {
        "1": {
          "name": "keyword.other.set.brl"
        },
        "2": {
          "name": "variable.other.brl"
        },
        "3": {
          "name": "keyword.other.to.brl"
        }
      }
    },
    "variable-ref": {
      "comment": "ODM ruleset variable references: 'the request', 'the decision'",
      "name": "variable.other.brl",
      "match": "'[^']+'"
    },
    "string": {
      "name": "string.quoted.double.brl",
      "begin": "\"",
      "end": "\"",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.string.begin.brl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.string.end.brl"
        }
      },
      "patterns": [
        {
          "name": "constant.character.escape.brl",
          "match": "\\\\."
        }
      ]
    },
    "number": {
      "name": "constant.numeric.brl",
      "match": "\\b-?\\d+(\\.\\d+)?\\b"
    },
    "boolean-literal": {
      "name": "constant.language.boolean.brl",
      "match": "\\b(true|false)\\b"
    },
    "set-literal": {
      "comment": "is one of { \"A\", \"B\" }",
      "name": "meta.set-literal.brl",
      "begin": "\\{",
      "end": "\\}",
      "beginCaptures": {
        "0": {
          "name": "punctuation.definition.set.begin.brl"
        }
      },
      "endCaptures": {
        "0": {
          "name": "punctuation.definition.set.end.brl"
        }
      },
      "patterns": [
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "name": "punctuation.separator.comma.brl",
          "match": ","
        }
      ]
    },
    "statement-terminator": {
      "comment": "Semicolon ending each action statement",
      "name": "punctuation.terminator.statement.brl",
      "match": ";"
    },
    "xml-rule": {
      "comment": "ODM Rule Designer .brl files: XML envelope with BAL inside <definition><![CDATA[ ... ]]>",
      "patterns": [
        {
          "name": "meta.tag.preprocessor.xml.brl",
          "match": "<\\?xml.*?\\?>"
        },
        {
          "name": "meta.embedded.block.bal.brl",
          "begin": "(<)(definition)(>)(<!\\[CDATA\\[)",
          "end": "(\\]\\]>)(</)(definition)(>)",
          "beginCaptures": {
            "1": {
              "name": "punctuation.definition.tag.begin.xml"
            },
            "2": {
              "name": "entity.name.tag.xml"
            },
            "3": {
              "name": "punctuation.definition.tag.end.xml"
            },
            "4": {
              "name": "punctuation.definition.string.begin.xml"
            }
          },
          "endCaptures": {
            "1": {
              "name": "punctuation.definition.string.end.xml"
            },
            "2": {
              "name": "punctuation.definition.tag.begin.xml"
            },
            "3": {
              "name": "entity.name.tag.xml"
            },
            "4": {
              "name": "punctuation.definition.tag.end.xml"
            }
          },
          "patterns": [
            {
              "include": "#bal-body"
            }
          ]
        },
        {
          "match": "(<)(name)(>)([^<]*)(</)(name)(>)",
          "captures": {
            "2": {
              "name": "entity.name.tag.xml"
            },
            "4": {
              "name": "entity.name.function.rule.brl"
            },
            "6": {
              "name": "entity.name.tag.xml"
            }
          }
        },
        {
          "name": "comment.block.xml.brl",
          "begin": "<!--",
          "end": "-->"
        },
        {
          "match": "(</?)([\\w.:-]+)([^>]*?)(/?>)",
          "captures": {
            "1": {
              "name": "punctuation.definition.tag.begin.xml"
            },
            "2": {
              "name": "entity.name.tag.xml"
            },
            "3": {
              "name": "meta.attribute.xml"
            },
            "4": {
              "name": "punctuation.definition.tag.end.xml"
            }
          }
        }
      ]
    },
    "bal-body": {
      "comment": "Flat BAL patterns (no nested regions, so the CDATA end always closes the block)",
      "patterns": [
        {
          "match": "\\b(definitions)\\b",
          "name": "keyword.control.definitions.brl"
        },
        {
          "match": "\\b(if)\\b",
          "name": "keyword.control.if.brl"
        },
        {
          "match": "\\b(then)\\b",
          "name": "keyword.control.then.brl"
        },
        {
          "match": "\\b(else)\\b",
          "name": "keyword.control.else.brl"
        },
        {
          "include": "#comment"
        },
        {
          "include": "#set-statement"
        },
        {
          "include": "#action-keywords"
        },
        {
          "include": "#logical-operators"
        },
        {
          "include": "#comparison-operators"
        },
        {
          "include": "#null-keywords"
        },
        {
          "include": "#collection-keywords"
        },
        {
          "include": "#negation"
        },
        {
          "include": "#variable-ref"
        },
        {
          "include": "#string"
        },
        {
          "include": "#number"
        },
        {
          "include": "#boolean-literal"
        },
        {
          "include": "#set-literal"
        },
        {
          "include": "#statement-terminator"
        }
      ]
    }
  }
}