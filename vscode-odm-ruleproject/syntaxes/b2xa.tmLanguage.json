{
  "$schema": "https://raw.githubusercontent.com/martinring/tmlanguage/master/tmlanguage.json",
  "name": "ODM BOM to ARL Translation",
  "scopeName": "text.xml.odm-b2xa",
  "patterns": [
    {
      "match": "(<id>)([^<]*)(</id>)",
      "captures": {
        "1": { "name": "meta.tag.xml" },
        "2": { "name": "constant.other.uuid.odm-b2xa" },
        "3": { "name": "meta.tag.xml" }
      }
    },
    {
      "match": "(<lang>)([^<]*)(</lang>)",
      "captures": {
        "1": { "name": "meta.tag.xml" },
        "2": { "name": "support.constant.language.odm-b2xa" },
        "3": { "name": "meta.tag.xml" }
      }
    },
    { "include": "text.xml" }
  ]
}
